{
  "services": {
    "client": {
      "root": "client"
    },
    "server": {
      "root": "server"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/songs/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
